services:
  postgres:
    image: postgres:18
    container_name: lookana-postgres
    restart: unless-stopped

    environment:
      POSTGRES_USER: db_user
      POSTGRES_PASSWORD: dbpass
      POSTGRES_DB: db_db

    ports:
      - "5433:5432"

    volumes:
      - postgres_data:/var/lib/postgresql

volumes:
  postgres_data:
